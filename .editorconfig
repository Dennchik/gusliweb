# Корневой файл настроек
root = true

[*]
# ==========================================
# ОБЩИЕ НАСТРОЙКИ ДЛЯ ВСЕХ ФАЙЛОВ В ПРОЕКТЕ
# ==========================================
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# ==========================================
# НАСТРОЙКИ ДЛЯ SCSS ФАЙЛОВ
# ==========================================
[*.scss]
indent_size = 2
max_line_length = 80
end_of_line = lf

# Поддерживаемые настройки PhpStorm
ij_wrap_on_typing = true
ij_visual_guides = 80

# ==========================================
# НАСТРОЙКИ ДЛЯ PHP ФАЙЛОВ
# ==========================================
[*.php]
# # Задает максимальную длину строки, по которой PhpStorm будет переносить комментарии
# max_line_length = 120
# indent_size = 4
#
# # Управление пустыми строками внутри блоков
# ij_any_keep_blank_lines_in_code = 0
# ij_any_keep_blank_lines_in_declarations = 0